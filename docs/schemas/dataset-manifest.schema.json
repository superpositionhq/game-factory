{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset-layout/v1.1/manifest",
  "title": "Dataset manifest.json",
  "description": "Metadata of one game's dataset and the path, size and sha256 of every other file in it. Cross-file rules (files exist and match, status complete needs a passing replay report, commit = last git.log commit) are in docs/game-format-v1.json, dataset.manifest.",
  "type": "object",
  "required": ["layout", "game", "title", "version", "commit", "status", "variant", "pending", "scenarios", "totals", "files"],
  "properties": {
    "layout": { "const": "dataset-layout/v1.1" },
    "game": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$", "description": "the game's slug; also the zip's top folder" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "commit": { "$ref": "#/$defs/sha1" },
    "status": { "enum": ["complete", "pending"] },
    "variant": { "enum": ["full", "repo-dataset"], "description": "full = Dataset.zip (with UEProject/ and Build/); repo-dataset = the game repo's Dataset/ folder" },
    "pending": { "type": "array", "items": { "type": "string" }, "description": "entries still missing (only ReplayScripts may be); empty when complete" },
    "created": { "type": "string" },
    "source_package": { "type": "string" },
    "replay_verification": {
      "type": "object",
      "required": ["pass", "report", "criteria", "exclusions"],
      "properties": {
        "pass": { "type": "boolean" },
        "report": { "type": "string" },
        "criteria": { "type": "array", "items": { "type": "object", "required": ["id", "text", "result", "pass"], "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "result": { "type": "string" }, "pass": { "type": "boolean" } } } },
        "exclusions": { "type": "array", "items": { "type": "object", "required": ["id", "what", "count"], "properties": { "id": { "type": "string" }, "what": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } } } }
      }
    },
    "build": {
      "type": ["object", "null"],
      "description": "the packaged build in Build/ (full variant); null in the repo Dataset/",
      "required": ["config", "commit", "exe"],
      "properties": { "config": { "enum": ["Shipping"] }, "commit": { "$ref": "#/$defs/sha1" }, "exe": { "type": "string", "pattern": "\\.exe$" }, "source": { "type": "string" } }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "scenario", "name", "result", "seconds"],
        "properties": {
          "file": { "type": "string", "pattern": "^Gameplay/[a-z0-9-]+_S[0-9]+\\.mp4$" },
          "scenario": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "result": { "enum": ["win", "lose", "timeout", "abort"] },
          "seconds": { "type": "number", "minimum": 0 },
          "source_run": { "type": "string" },
          "audio_offset_s": { "type": "number" }
        }
      }
    },
    "totals": { "type": "object", "required": ["files", "bytes"], "properties": { "files": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 } } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "additionalProperties": false
      }
    }
  },
  "$defs": { "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
}
